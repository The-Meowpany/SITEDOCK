# ── Database ──────────────────────────────────────────────
POSTGRES_USER=sitedock
POSTGRES_PASSWORD=sitedock
POSTGRES_DB=sitedock
# Local Docker Compose: postgresql://sitedock:sitedock@postgres:5432/sitedock?schema=public
# WSL2 PostgreSQL: postgresql://sitedock:sitedock@<WSL2_IP>:5432/sitedock?schema=public
# Native PostgreSQL: postgresql://sitedock:sitedock@localhost:5432/sitedock?schema=public
DATABASE_URL="postgresql://sitedock:sitedock@localhost:5432/sitedock?schema=public"

# ── Test database ─────────────────────────────────────────
# Dedicated namespace for the PostgreSQL integration tests. It MUST point at a
# schema other than `public`: the suites fail closed otherwise and never touch
# application data. Provision it once with: npm run db:test:setup
SITEDOCK_TEST_DATABASE_URL="postgresql://sitedock:sitedock@localhost:5432/sitedock?schema=sitedock_test"

# ── API ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── Billing / Demo ────────────────────────────────────────
PLATFORM_FEE_PERCENTAGE=10
DEMO_MODE=true

# ── Payment provider (mock por defecto para desarrollo local) ─────
# PAYMENT_PROVIDER=mock          # mock | stripe
# STRIPE_SECRET_KEY=             # sk_test_... (sandbox primero, SIEMPRE)
# STRIPE_WEBHOOK_SECRET=         # whsec_... del endpoint de webhooks configurado en Stripe
# STRIPE_API_BASE=https://api.stripe.com  # override para proxies/tests

# ── Storage provider ─────────────────────────────────────
# mock = solo en memoria: los deployments y backups desaparecen al reiniciar
#        el proceso (no sirve para backups ni para host local persistente).
# disk  = ficheros en STORAGE_DIR; válido para self-hosting sin S3.
# s3    = producción.
# STORAGE_PROVIDER=mock          # mock | disk | s3
# STORAGE_DIR=.data/storage      # solo con STORAGE_PROVIDER=disk
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                     # override para MinIO/tests

# ── Backups ───────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30

# ── Email provider (mock por defecto para desarrollo local) ─────
# EMAIL_PROVIDER=mock              # mock | resend
# RESEND_FROM="SiteDock <noreply@localhost>"   # remitente verificado en Resend
# RESEND_API_KEY=

# ── Local development (Caddy HTTP only, no TLS) ───────────
# ACME_EMAIL=admin@localhost
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Runtime agent (container runtime for service deployments) ───
# The worker never talks to podman directly: it calls the trusted runtime agent
# (apps/runtime-agent/agent.mjs) over this authenticated local endpoint.
# RUNTIME_AGENT_TOKEN must be at least 32 characters: openssl rand -hex 32
# Without these two values every service deployment fails with
# RUNTIME_AGENT_UNAVAILABLE and no container is ever started.
# RUNTIME_AGENT_URL=http://127.0.0.1:4010
# RUNTIME_AGENT_TOKEN=
#
# Host requirement for rootless podman (the agent runs as a non-root user on a
# Linux host and creates containers with `--userns=auto`): the agent's user
# MUST have subordinate ID ranges, or `podman run` fails with
# "no subuid ranges found". One-time host setup:
#   usermod --add-subuids 100000-165535 --add-subgids 100000-165535 <agent-user>
#   podman system migrate
# Verify with: grep <agent-user> /etc/subuid /etc/subgid

# ── Service secrets ──────────────────────────────────────
# Key used to encrypt service environment secrets at rest (64 hex chars).
# Without it, deploying a service that has secrets fails with
# SECRETS_KEY_NOT_CONFIGURED.
# SITEDOCK_SECRETS_KEY=

# ── Logging ───────────────────────────────────────────────
# ── Domains / DNSHE / TLS ────────────────────────────────
# DOMAIN_PROVIDER=mock            # mock | dnshe (dnshe requires all values below)
# SITEDOCK_BASE_DOMAIN=sitedock.us.ci
# SITEDOCK_PUBLIC_IP=             # edge IPv4 for the wildcard A record
# SITEDOCK_EDGE_HOSTNAME=edge.sitedock.us.ci
# SITEDOCK_CONTROL_HOSTS=api,www,admin,app,portal
# DNSHE_API_KEY=
# DNSHE_API_SECRET=
# DNSHE_API_BASE_URL=https://api005.dnshe.com/index.php
# TLS_ASK_SECRET=                 # openssl rand -hex 32; shared with Caddy's on-demand TLS ask

# -- CLI (client-side, do not put production tokens in this file) --
# SITEDOCK_API_URL=http://localhost:4000
# SITEDOCK_API_TOKEN=sitedock_pat_...
# SITEDOCK_WORKSPACE_ID=

# -- GitHub App --
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=sitedock
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_REDIRECT_URI=https://app.sitedock.us.ci/github/callback
# NEXT_PUBLIC_GITHUB_APP_SLUG=sitedock

LOG_LEVEL=debug

# Never commit a real .env with secrets. This file is committed on purpose as a template.
