# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://sitedock:sitedock@localhost:5432/sitedock?schema=public"

# ── API ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# ── Billing / Demo ────────────────────────────────────────
# PLATFORM_FEE_PERCENTAGE=10     # revenue share de la plataforma (brief §8)
# DEMO_MODE=false                # fuerza OFF de /demo-payments/* aunque no estés en production

# ── Stripe Connect (Fase 16 — dinero real) ────────────────
# PAYMENT_PROVIDER=mock          # mock | stripe
# STRIPE_SECRET_KEY=             # sk_test_... (sandbox primero, SIEMPRE)
# STRIPE_WEBHOOK_SECRET=         # whsec_... del endpoint de webhooks configurado en Stripe
# STRIPE_API_BASE=https://api.stripe.com  # override para proxies/tests

# ── Payments (Phase: Billing — not wired yet) ────────────
# PAYMENT_PROVIDER=mock            # mock | stripe | mercadopago
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Storage (Phase: Deployment — not wired yet) ──────────
# STORAGE_PROVIDER=mock            # mock | s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                     # override para MinIO/tests

# ── Backups (Fase 10) ────────────────────────────────────
# BACKUP_RETENTION_DAYS=30          # días de retención antes del cleanup automático

# ── Email (Phase: Notification — not wired yet) ──────────
# EMAIL_PROVIDER=mock              # mock | resend
# RESEND_FROM="SiteDock <hola@tudominio.com>"   # remitente verificado en Resend
# RESEND_API_KEY=

# Never commit a real .env with secrets. This file is committed on purpose as a template.



