{
  "name": "sitedock",
  "private": true,
  "version": "0.1.0",
  "description": "SiteDock \u2014 Recurring Website Infrastructure for Freelancers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/test-wrapper.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "e2e": "node scripts/e2e-demo.mjs",
    "db:generate": "npm run db:generate -w packages/database",
    "db:migrate": "npm run db:migrate -w packages/database",
    "db:test:setup": "node scripts/setup-test-database.mjs",
    "db:migrate:verify": "node scripts/verify-migrations.mjs",
    "db:migrate:verify:existing": "node scripts/verify-existing-database-reconciliation.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.67.0"
  }
}
